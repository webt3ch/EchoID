# AudD API token — keep this server-side; never prefix it with NEXT_PUBLIC_
AUDD_API_TOKEN=your_audd_api_token

# Supabase project settings for optional account and cloud sync.
# The anon key is intended for browser use; protect data with the RLS policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
